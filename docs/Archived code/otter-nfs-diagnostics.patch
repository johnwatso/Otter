@@ -0,0 +1,69 @@
+import Foundation
+
+/// Lists a server's NFS exports over the MOUNT protocol. Servers that do not
+/// answer `showmount` — NFSv4 only, or a filtered portmapper — leave the list
+/// unavailable rather than empty, so the panel can offer manual entry instead
+/// of claiming the server has no exports.
+struct NFSExportInspector {
+    func exports(host: String, runner: DiagnosticCommandRunner = DiagnosticCommandRunner()) async -> [String]? {
+        guard Self.isQueryableHost(host),
+              let output = await runner.run("/usr/bin/showmount", ["-e", host], timeout: 10) else { return nil }
+        let paths = Self.parse(output)
+        return paths.isEmpty ? nil : paths
+    }
+
+    /// A leading dash would be read as an option by the utility.
+    static func isQueryableHost(_ host: String) -> Bool {
+        !host.isEmpty && host.count <= 253 && !host.hasPrefix("-")
+            && host.rangeOfCharacter(from: .whitespacesAndNewlines) == nil
+            && host != "Unavailable"
+    }
+
+    /// `showmount -e` prints a header line, then one export per line followed by
+    /// its access list. The access list is never shown or reported.
+    static func parse(_ text: String) -> [String] {
+        var paths: [String] = []
+        for line in text.components(separatedBy: .newlines) {
+            let trimmed = line.trimmingCharacters(in: .whitespaces)
+            guard trimmed.hasPrefix("/") else { continue }
+            // The access list is column-aligned, so two or more spaces end the
+            // path. A single space stays part of it.
+            let path = DiagnosticParsing.capture(#"^(/\S(?:.*?\S)?)(?:\s{2,}.*)?$"#, in: trimmed)?.first ?? trimmed
+            guard let normalized = normalizedExport(path), !paths.contains(normalized) else { continue }
+            paths.append(normalized)
+            if paths.count == 64 { break }
+        }
+        return paths
+    }
+
+    /// Accepts an absolute export path only, with no relative or empty segments.
+    static func normalizedExport(_ path: String) -> String? {
+        let trimmed = path.trimmingCharacters(in: .whitespaces)
+        guard trimmed.hasPrefix("/"), trimmed.count <= 1024,
+              trimmed.rangeOfCharacter(from: CharacterSet.newlines.union(.controlCharacters)) == nil else { return nil }
+        let components = trimmed.split(separator: "/", omittingEmptySubsequences: true).map(String.init)
+        guard !components.isEmpty, !components.contains("."), !components.contains("..") else { return nil }
+        return "/" + components.joined(separator: "/")
+    }
+
+    /// Where the servers Otter is used with put a share when the export list is
+    /// unavailable. UniFi Drive is first: it exports each shared drive as
+    /// `/var/nfs/shared/<name>` and does not answer an export listing.
+    /// These are starting points for the user to confirm, never a guess Otter
+    /// acts on by itself.
+    static func suggestedExports(shareName: String) -> [String] {
+        let name = shareName.trimmingCharacters(in: .whitespaces)
+        guard !name.isEmpty, name != "Unavailable", normalizedExport("/" + name) != nil else { return [] }
+        return ["/var/nfs/shared/\(name)", "/volume1/\(name)", "/mnt/\(name)", "/\(name)"]
+    }
+
+    /// An export path rarely equals the SMB share name, but its last component
+    /// usually does. Anything less certain is left for the user to choose.
+    static func bestMatch(in exports: [String], shareName: String) -> String? {
+        let name = shareName.trimmingCharacters(in: .whitespaces).lowercased()
+        guard !name.isEmpty, name != "unavailable" else { return exports.count == 1 ? exports.first : nil }
+        let matches = exports.filter { $0.split(separator: "/").last?.lowercased() == name }
+        if matches.count == 1 { return matches.first }
+        return matches.isEmpty && exports.count == 1 ? exports.first : nil
+    }
+}
