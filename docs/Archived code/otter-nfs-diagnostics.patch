+extension NASDiagnosticsTests {
+    func testNFSExportListingKeepsPathsAndDropsHeadersAndAccessLists() {
+        let output = """
+        Exports list on nas.local:
+        /volume1/Vault                      10.11.1.0/24
+        /volume1/Time Machine               Everyone
+        /volume1/Vault                      backup.local
+        not-an-export                       Everyone
+        /volume1/../etc                     Everyone
+        """
+        XCTAssertEqual(NFSExportInspector.parse(output), ["/volume1/Vault", "/volume1/Time Machine"])
+        XCTAssertEqual(NFSExportInspector.parse("showmount: Cannot retrieve info from host"), [])
+        XCTAssertEqual(NFSExportInspector.normalizedExport("//volume1///Vault/"), "/volume1/Vault")
+        for rejected in ["volume1/Vault", "/volume1/../etc", "/./secrets", "", "/vol\nume"] {
+            XCTAssertNil(NFSExportInspector.normalizedExport(rejected), rejected)
+        }
+        XCTAssertFalse(NFSExportInspector.isQueryableHost("-e"))
+        XCTAssertFalse(NFSExportInspector.isQueryableHost("nas.local extra"))
+        XCTAssertTrue(NFSExportInspector.isQueryableHost("nas.local"))
+    }
+
+    func testNFSExportMatchingOnlyGuessesWhenTheChoiceIsUnambiguous() {
+        let exports = ["/volume1/Vault", "/volume2/vault", "/volume1/Media"]
