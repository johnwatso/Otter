+    /// Session-only NFS address for an SMB share. The configured server name is
+    /// kept; only the protocol and the exported path change.
+    static func temporaryNFSURL(share: NetworkShare, export: String) -> URL? {
+        guard let url = share.url, url.scheme == "smb",
+              let host = share.host, !host.isEmpty,
+              let path = NFSExportInspector.normalizedExport(export) else { return nil }
+        var components = URLComponents()
+        components.scheme = "nfs"
+        components.host = NetworkShare.isIPAddress(host) ? NetworkShare.urlComponentsHost(forIPAddress: host) : host
+        components.path = path
+        return components.url
+    }
