<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened runtime: required for the Wi-Fi network name (CoreLocation/CoreWLAN). -->
	<key>com.apple.security.personal-information.location</key>
	<true/>
	<!-- Only takes effect under the App Sandbox, which Otter does not use. Declared so outgoing network access is explicit. -->
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
